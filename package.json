{
  "name": "pipx-install-action",
  "description": "GitHub Action that installs Python CLI packages with pipx",
  "version": "1.0.0",
  "author": "",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/python-build-tools/pipx-install-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/python-build-tools/pipx-install-action.git"
  },
  "bugs": {
    "url": "https://github.com/python-build-tools/pipx-install-action/issues"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "package": "rollup --config rollup.config.js",
    "package:watch": "npm run package -- --watch",
    "test": "(NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest && make-coverage-badge --output-path ./badges/coverage.svg) || make-coverage-badge --output-path ./badges/coverage.svg",
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "act-test": "act --workflows __tests__/data/"
  },
  "license": "MIT",
  "eslintConfig": {
    "extends": "./.github/linters/.eslintrc.yml"
  },
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@iarna/toml": "^2.2.5",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@jest/globals": "^30.4.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.3",
    "js-yaml": "^4.1.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.6.2",
    "rollup": "^4.62.4",
    "rollup-plugin-license": "^3.7.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
